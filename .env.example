# ============================================================
# Site institucional - variaveis de ambiente
# ============================================================
# Copie para .env.local (ignorado pelo git) e ajuste.
# Nenhuma destas variaveis e segredo: todas sao publicas por
# natureza (NEXT_PUBLIC_*). O site NAO acessa o Supabase e nao
# precisa de nenhuma chave de banco.

# URL publica do site. Usada em canonical, Open Graph e sitemap.
NEXT_PUBLIC_SITE_URL=https://www.rotamoove.com.br

# Links das lojas. Enquanto vazios, as chamadas para acao apontam
# para a pagina interna /aplicativo. Preencher quando publicar.
NEXT_PUBLIC_ANDROID_URL=
NEXT_PUBLIC_IOS_URL=
